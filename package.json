{
  "name": "mbti-mcp",
  "version": "1.0.0",
  "description": "MCP server for MBTI personality type testing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
